{
  "architectures": [
    "MiniMaxForCausalLM"
  ],
  "attention_dropout": 0.0,
  "block_size": 4,
  "bos_token_id": 1,
  "dtype": "float32",
  "eos_token_id": 2,
  "full_attn_alpha_factor": 1.3,
  "full_attn_beta_factor": 0.8,
  "head_dim": 16,
  "hidden_act": "silu",
  "hidden_size": 64,
  "initializer_range": 0.02,
  "intermediate_size": 32,
  "layer_types": [
    "linear_attention",
    "full_attention",
    "linear_attention",
    "full_attention"
  ],
  "linear_attn_alpha_factor": 1.2,
  "linear_attn_beta_factor": 0.9,
  "max_position_embeddings": 256,
  "mlp_alpha_factor": 1.1,
  "mlp_beta_factor": 0.7,
  "model_type": "minimax",
  "num_attention_heads": 4,
  "num_experts_per_tok": 2,
  "num_hidden_layers": 4,
  "num_key_value_heads": 2,
  "num_local_experts": 4,
  "output_router_logits": false,
  "pad_token_id": 0,
  "rms_norm_eps": 1e-05,
  "rope_parameters": {
    "rope_theta": 10000.0,
    "rope_type": "default"
  },
  "router_aux_loss_coef": 0.001,
  "router_jitter_noise": 0.0,
  "sliding_window": null,
  "tie_word_embeddings": false,
  "transformers_version": "5.21.0",
  "use_cache": true,
  "vocab_size": 512
}
